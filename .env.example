# Copy this file to .env and change values there.
# .env is git-ignored, so your own settings and keys stay private.
# Every value below is optional - config/settings.py has the same defaults.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Data mode ---
# debug = results pages use fixed sample data (dummy_data.py)
# live  = results pages use real saved data (empty until Sprint 2)
DATA_MODE=debug

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Job search ---
# Most Jobstreet jobs the AI finds for one resume
MAX_JOBS=15

# --- AI Manager (Sprint 4) ---
# mock = fake AI replies, no key needed
# live = real AI API calls, needs AI_API_KEY
AI_MODE=mock
# Your free Gemini key (https://aistudio.google.com/apikey) - never put it in settings.py
AI_API_KEY=
# Gemini model (must be one on the free tier)
AI_MODEL=gemini-3.8-flash
# Backup models (comma-separated) used if AI_MODEL is busy
AI_FALLBACK_MODELS=gemini-3.5-flash
